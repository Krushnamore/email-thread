*.db
*.sqlite
*.sqlite3
*.log

# Generated ML outputs and local caches
backend/ml/artifacts/*
!backend/ml/artifacts/metrics.json
*.cache

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/